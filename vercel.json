{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "rewrites": [
    {
      "source": "/img/:path*",
      "destination": "https://img.elbaloncestodeayer.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }]
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/mention-digest",
      "schedule": "0 7 * * *"
    }
  ]
}
