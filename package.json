{
  "name": "elbaloncestodeayer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --fail-on error",
    "db:types": "supabase gen types typescript > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "env:local": "sh scripts/env-local.sh",
    "admin:list": "node --env-file=.env.local scripts/admin.mts list",
    "admin:grant": "node --env-file=.env.local scripts/admin.mts grant",
    "prod:db-push": "sh scripts/prod.sh supabase db push --remote",
    "prod:config-diff": "sh scripts/prod.sh supabase config diff",
    "prod:config-push": "sh scripts/prod.sh supabase config push",
    "prod:admin": "node --env-file=.env.prod scripts/admin.mts",
    "import:instagram": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/import-instagram.mts",
    "prod:import-instagram": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.prod scripts/import-instagram.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "aws4fetch": "^1.0.20",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
