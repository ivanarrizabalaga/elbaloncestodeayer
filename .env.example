# Variable names only. Never commit real values.
#
# .env.local  -> local development. `pnpm db:start` then `pnpm env:local` writes it for you.
# .env.prod   -> production values for the `pnpm prod:*` scripts. Copy this file and fill it in.
# Vercel      -> NEXT_PUBLIC_*, CRON_SECRET and R2_* (Project Settings -> Environment Variables). Never SUPABASE_SECRET_KEY.

# Supabase project (public: safe in the browser, access is limited by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: local scripts only (bypasses RLS). Never expose it, never in Vercel.
SUPABASE_SECRET_KEY=

# .env.prod only: Postgres password, used by `pnpm prod:db-push` (asked for if empty).
SUPABASE_DB_PASSWORD=

# .env.prod only: Resend API key, sent to Supabase Auth as SMTP password by `pnpm prod:config-push`.
RESEND_API_KEY=

# Vercel only (Production): protects /api/keep-alive. Any long random string.
CRON_SECRET=

# Images (Cloudflare R2). Local development uses the *-dev-* buckets, production the others.
# Public base URL of the derivatives bucket: the r2.dev URL in dev, https://img.elbaloncestodeayer.com in production.
NEXT_PUBLIC_IMAGES_URL=
# S3 API of the EU buckets: https://<account-id>.eu.r2.cloudflarestorage.com (server only).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_ORIGINALS_BUCKET=
