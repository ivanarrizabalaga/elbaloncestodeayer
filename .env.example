# Copy to .env.local and fill in. Never commit real values.
# Local values: run `pnpm db:start`, then `pnpm env:local` writes .env.local for you.

# Supabase project (public: safe in the browser, access is limited by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: server and local scripts only (bypasses RLS). Never expose it.
SUPABASE_SECRET_KEY=
